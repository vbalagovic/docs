{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Neural Draft",
  "description": "Hosting, CMS, blog, bookings, forms and a shop for sites built with Claude, ChatGPT, Codex or your own code: hosted connector, developer MCP, REST API and TypeScript SDK.",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#5B21B6"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://neuraldraft.io"
  },
  "favicon": "/favicon.svg",
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B0712"
    },
    "decoration": "gradient"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Inter"
  },
  "api": {
    "openapi": [
      "openapi.yaml"
    ],
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "node",
        "python",
        "php"
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Changelog",
        "href": "/changelog"
      },
      {
        "label": "Pricing",
        "href": "https://neuraldraft.io/pricing"
      },
      {
        "label": "For developers",
        "href": "https://neuraldraft.io/developers"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get API key",
      "href": "https://app.neuraldraft.io/register"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Build with AI",
            "pages": [
              "guides/hosted-connector",
              "mcp/overview",
              "mcp/setup",
              "mcp/multi-workspace",
              "mcp/tools-and-resources"
            ]
          },
          {
            "group": "Sites",
            "pages": [
              "guides/hosted-sites",
              "guides/editable-markup",
              "guides/client-editing",
              "guides/site-pages",
              "guides/languages",
              "guides/embeds-and-cors",
              "guides/custom-domains"
            ]
          },
          {
            "group": "Agencies",
            "pages": [
              "guides/agencies"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "pillars/cms",
              "pillars/galleries",
              "pillars/blog",
              "pillars/booking",
              "pillars/commerce",
              "guides/shop-and-payments",
              "pillars/social"
            ]
          },
          {
            "group": "SDK and API",
            "pages": [
              "sdk",
              "pricing-and-credits",
              "errors",
              "rate-limits",
              "webhooks"
            ]
          },
          {
            "group": "Snippets",
            "pages": [
              "frameworks/nextjs",
              "frameworks/astro",
              "frameworks/nuxt",
              "frameworks/vanilla",
              "frameworks/cursor",
              "frameworks/lovable"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.yaml"
      },
      {
        "tab": "Changelog",
        "pages": [
          "changelog"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "SDK",
          "href": "https://github.com/vbalagovic/neuraldraft-sdk",
          "icon": "github"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.gg/XCQftzvBQX",
          "icon": "discord"
        }
      ]
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/vbalagovic/neuraldraft-sdk",
      "discord": "https://discord.gg/XCQftzvBQX",
      "x": "https://x.com/neuraldraft"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Pricing",
            "href": "https://neuraldraft.io/pricing"
          },
          {
            "label": "Changelog",
            "href": "/changelog"
          },
          {
            "label": "Status",
            "href": "https://status.neuraldraft.io"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "SDK on GitHub",
            "href": "https://github.com/vbalagovic/neuraldraft-sdk"
          },
          {
            "label": "MCP on npm",
            "href": "https://www.npmjs.com/package/@neuraldraft/mcp"
          },
          {
            "label": "API reference",
            "href": "/api-reference"
          },
          {
            "label": "Quickstart",
            "href": "/quickstart"
          }
        ]
      },
      {
        "header": "Community",
        "items": [
          {
            "label": "Discord",
            "href": "https://discord.gg/XCQftzvBQX"
          },
          {
            "label": "GitHub issues",
            "href": "https://github.com/vbalagovic/neuraldraft-sdk/issues"
          }
        ]
      },
      {
        "header": "Company",
        "items": [
          {
            "label": "Contact",
            "href": "mailto:info@neuraldraft.io"
          },
          {
            "label": "Terms",
            "href": "https://neuraldraft.io/legal/terms"
          },
          {
            "label": "Privacy",
            "href": "https://neuraldraft.io/legal/privacy"
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search the docs, MCP setup, errors, anything"
  },
  "seo": {
    "metatags": {
      "og:image": "/images/og.png",
      "twitter:card": "summary_large_image"
    },
    "indexing": "all"
  },
  "errors": {
    "404": {
      "redirect": false
    }
  },
  "redirects": [
    {
      "source": "/api",
      "destination": "/api-reference"
    },
    {
      "source": "/docs",
      "destination": "/"
    },
    {
      "source": "/migration-from-saas",
      "destination": "/introduction"
    },
    {
      "source": "/guides/stripe-connect-setup",
      "destination": "/guides/shop-and-payments"
    }
  ]
}
